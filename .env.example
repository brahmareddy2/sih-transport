# ═══════════════════════════════════════════════════════════
#  AI-Powered Logistics DSS — Environment Variable Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────
ENVIRONMENT=development
# Options: development | production

# ── PostgreSQL Database ───────────────────────────────────
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=logistics_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full DSN (auto-built from above in production, override here if needed)
# DATABASE_URL=postgresql://logistics_user:password@db:5432/logistics_db

# ── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── JWT Authentication ────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_256_bit_random_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (comma-separated list of allowed origins) ────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# ── External APIs ─────────────────────────────────────────
# OpenRouteService — get free key at https://openrouteservice.org/
ORS_API_KEY=your_openrouteservice_api_key_here
ORS_BASE_URL=https://api.openrouteservice.org

# Open-Meteo (weather) — no API key required, free
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Nominatim (geocoding) — free, requires User-Agent
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=sih-logistics-dss/1.0

# ── Toll Model (Rule-Based) ───────────────────────────────
# INR per kilometer by road type
TOLL_RATE_PER_KM_NH=1.20
TOLL_RATE_PER_KM_SH=0.75
TOLL_RATE_PER_KM_OTHER=0.00

# ── Indian Fuel Prices (INR per liter / kg) ───────────────
DIESEL_PRICE_PER_LITER=92.50
PETROL_PRICE_PER_LITER=102.00
CNG_PRICE_PER_KG=85.00
# CO2 emission factor — kg CO2 per liter of diesel (DEFRA standard)
CO2_FACTOR_DIESEL=2.68
CO2_FACTOR_PETROL=2.31
CO2_FACTOR_CNG=1.90

# ── Driver Cost ───────────────────────────────────────────
DRIVER_COST_PER_HOUR_INR=120.00

# ── Synthetic Data Generator ──────────────────────────────
SEED_RANDOM_SEED=42
SEED_NUM_VEHICLES=50
SEED_NUM_DRIVERS=50
SEED_NUM_SHIPMENTS=500
SEED_NUM_HISTORICAL_TRIPS=300
SEED_NUM_INCIDENTS=80

# ── Admin Bootstrap ───────────────────────────────────────
ADMIN_EMAIL=admin@logistics.in
ADMIN_PASSWORD=Admin@123!
ADMIN_FULL_NAME=System Administrator

# ── Notifications (optional — leave blank to disable) ─────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@logistics.in

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR
